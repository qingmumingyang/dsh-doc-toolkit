{
  "name": "dsh-doc-toolkit",
  "version": "0.2.0",
  "description": "DSH 文档读写工具包 - 支持 PDF/DOCX/XLSX/CSV 读写与 PDF 导出（零运行时依赖）",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "skills",
    "PERMISSIONS.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test tests/tests.mjs tests/real-backend.test.mjs tests/oracle-zip-ooxml.test.mjs tests/oracle-pdf.test.mjs",
    "test:unit": "node --test tests/tests.mjs",
    "test:oracle": "node --test tests/oracle-zip-ooxml.test.mjs tests/oracle-pdf.test.mjs",
    "test:real-backend": "node --test tests/real-backend.test.mjs",
    "verify:publish-policy": "node tests/store-gate-replica.mjs",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/qingmumingyang/dsh-doc-toolkit"
  },
  "homepage": "https://github.com/qingmumingyang/dsh-doc-toolkit#readme",
  "bugs": {
    "url": "https://github.com/qingmumingyang/dsh-doc-toolkit/issues"
  },
  "author": "qingmumingyang",
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^20.0.0",
    "docx": "^8.2.0",
    "mammoth": "^1.6.0",
    "pdf-parse": "^1.1.1",
    "typescript": "^5.0.0",
    "xlsx": "^0.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.12 <0.2.0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "pluginType": "feature",
    "compatibility": {
      "dsh": ">=0.1.0-rc.12 <0.2.0",
      "dshReleases": {
        "0.1.5-rc.1": "compatible",
        "0.1.5-rc.3": "compatible",
        "0.1.7-alpha.2": "compatible",
        "0.1.7-rc.1": "compatible",
        "0.1.7-rc.2": "compatible"
      },
      "dshOperations": {
        "0.1.5-rc.1": {
          "install": "passed",
          "start": "passed",
          "uninstall": "unknown",
          "rollback": "unknown"
        },
        "0.1.5-rc.3": {
          "install": "passed",
          "start": "unknown",
          "uninstall": "unknown",
          "rollback": "unknown"
        },
        "0.1.7-alpha.2": {
          "install": "passed",
          "start": "unknown",
          "uninstall": "unknown",
          "rollback": "unknown"
        },
        "0.1.7-rc.1": {
          "install": "passed",
          "start": "unknown",
          "uninstall": "unknown",
          "rollback": "unknown"
        },
        "0.1.7-rc.2": {
          "install": "passed",
          "start": "unknown",
          "uninstall": "unknown",
          "rollback": "unknown"
        }
      },
      "profiles": [
        "web"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "files",
    "tools",
    "document",
    "docx",
    "xlsx",
    "pdf",
    "csv",
    "文档读取",
    "文档生成",
    "办公文档",
    "表格转换",
    "PDF 导出"
  ],
  "license": "MIT"
}
